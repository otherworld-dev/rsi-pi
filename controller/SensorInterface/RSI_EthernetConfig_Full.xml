<ROOT>
   <CONFIG>
      <IP_NUMBER>10.10.10.10</IP_NUMBER>   <!-- IP-number of the external socket (the PC running RSIPI) -->
      <PORT>64000</PORT>                   <!-- Port-number of the external socket -->
      <SENTYPE>ImFree</SENTYPE>            <!-- The name of your system send in <Sen Type="" > -->
      <ONLYSEND>FALSE</ONLYSEND>           <!-- TRUE means the client don't expect answers. Do not send anything to robot -->
   </CONFIG>
   <!-- RSI Data: TYPE=  "BOOL", "STRING", "LONG", "DOUBLE" -->
   <!-- INDX= "INTERNAL" switch on internal read values. Needed by DEF_... -->
   <!-- INDX= "nmb" Input/Output index of RSI-Object / Maximum of RSI Channels: 64  -->
   <!-- HOLDON="1", set this output index of RSI Object to the last value  -->
   <!-- DEF_Delay count the late packages and send it back to server  -->
   <!-- DEF_Tech: .T = advance .C = main run / .T1 advance set function generator 1 -->

   <!-- ================================================================
        Channel map. Must match RSIPI_Full.rsi / RSIPI_Full.rsi.xml
        exactly: SEND INDX n is ETHERNET1 input n, RECEIVE INDX n is
        ETHERNET1 output n. The ETHERNET object carries max 64 inputs and
        64 outputs; INTERNAL (DEF_) elements are read straight from system
        variables and occupy no channel.

        SEND (robot to PC)
          1      DiL                  from DIGIN1        ($IN[1..8] as a byte)
          2-4    Digout.o1..o3        from DIGOUT1..3    ($OUT[1..3] readback)
          5      Source1              from SOURCE1       (signal generator)
          6-11   MotorCurrent.A1..A6  from MOTORCURRENT1
          12-17  PosCorrMon.X..C      from POSCORRMON1   (correction applied so far)
          18-23  AxisCorrMon.A1..A6   from AXISCORRMON1
          24-29  AxisCorrMon.E1..E6   from AXISCORRMON1
          29 of 64 inputs used

        RECEIVE (PC to robot)
          1-6    RKorr.X..C           to POSCORR1        (1..3 also feed MAP2SEN_PREA1..3)
          7-12   AKorr.A1..A6         to AXISCORR1
          13-18  EKorr.E1..E6         to AXISCORREXT1
          19     DiO                  to MAP2DIGOUT1     ($OUT[20..35] as a word)
          19 of 64 outputs used

        Robot pose, axis and motor-current state is read through DEF_
        INTERNAL elements instead of numbered POSACT/AXISACT channels;
        that is the pattern used by the real RSIVisual configurations this
        file was reconciled against, and it costs no channels.
        ================================================================ -->

   <!-- ===================== SEND: Robot to PC ========================= -->
   <SEND>
      <ELEMENTS>
         <ELEMENT TAG="DEF_RIst" TYPE="DOUBLE" INDX="INTERNAL" />      <!-- Cartesian actual position -->
         <ELEMENT TAG="DEF_RSol" TYPE="DOUBLE" INDX="INTERNAL" />      <!-- Cartesian setpoint position -->
         <ELEMENT TAG="DEF_AIPos" TYPE="DOUBLE" INDX="INTERNAL" />     <!-- Axis actual position A1-A6 -->
         <ELEMENT TAG="DEF_ASPos" TYPE="DOUBLE" INDX="INTERNAL" />     <!-- Axis setpoint position A1-A6 -->
         <ELEMENT TAG="DEF_EIPos" TYPE="DOUBLE" INDX="INTERNAL" />     <!-- External axis actual position E1-E6 -->
         <ELEMENT TAG="DEF_ESPos" TYPE="DOUBLE" INDX="INTERNAL" />     <!-- External axis setpoint position E1-E6 -->
         <ELEMENT TAG="DEF_MACur" TYPE="DOUBLE" INDX="INTERNAL" />     <!-- Motor currents A1-A6, % of max -->
         <ELEMENT TAG="DEF_MECur" TYPE="DOUBLE" INDX="INTERNAL" />     <!-- Motor currents E1-E6, % of max -->
         <ELEMENT TAG="DEF_Delay" TYPE="LONG" INDX="INTERNAL" />       <!-- Number of late data packets -->

         <!-- Technology parameters in the main run, function generators 1-6 -->
         <ELEMENT TAG="DEF_Tech.C1" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_Tech.C2" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_Tech.C3" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_Tech.C4" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_Tech.C5" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_Tech.C6" TYPE="DOUBLE" INDX="INTERNAL" />

         <!-- Channel 1: digital input byte (DIGIN1) -->
         <ELEMENT TAG="DiL" TYPE="LONG" INDX="1" />

         <!-- Channels 2-4: digital output readback (DIGOUT1-3) -->
         <ELEMENT TAG="Digout.o1" TYPE="BOOL" INDX="2" />
         <ELEMENT TAG="Digout.o2" TYPE="BOOL" INDX="3" />
         <ELEMENT TAG="Digout.o3" TYPE="BOOL" INDX="4" />

         <!-- Channel 5: signal generator (SOURCE1) -->
         <ELEMENT TAG="Source1" TYPE="DOUBLE" INDX="5" />

         <!-- Channels 6-11: motor currents (MOTORCURRENT1) -->
         <ELEMENT TAG="MotorCurrent.A1" TYPE="DOUBLE" INDX="6" />
         <ELEMENT TAG="MotorCurrent.A2" TYPE="DOUBLE" INDX="7" />
         <ELEMENT TAG="MotorCurrent.A3" TYPE="DOUBLE" INDX="8" />
         <ELEMENT TAG="MotorCurrent.A4" TYPE="DOUBLE" INDX="9" />
         <ELEMENT TAG="MotorCurrent.A5" TYPE="DOUBLE" INDX="10" />
         <ELEMENT TAG="MotorCurrent.A6" TYPE="DOUBLE" INDX="11" />

         <!-- Channels 12-17: Cartesian correction applied so far (POSCORRMON1) -->
         <ELEMENT TAG="PosCorrMon.X" TYPE="DOUBLE" INDX="12" />
         <ELEMENT TAG="PosCorrMon.Y" TYPE="DOUBLE" INDX="13" />
         <ELEMENT TAG="PosCorrMon.Z" TYPE="DOUBLE" INDX="14" />
         <ELEMENT TAG="PosCorrMon.A" TYPE="DOUBLE" INDX="15" />
         <ELEMENT TAG="PosCorrMon.B" TYPE="DOUBLE" INDX="16" />
         <ELEMENT TAG="PosCorrMon.C" TYPE="DOUBLE" INDX="17" />

         <!-- Channels 18-29: axis correction applied so far (AXISCORRMON1) -->
         <ELEMENT TAG="AxisCorrMon.A1" TYPE="DOUBLE" INDX="18" />
         <ELEMENT TAG="AxisCorrMon.A2" TYPE="DOUBLE" INDX="19" />
         <ELEMENT TAG="AxisCorrMon.A3" TYPE="DOUBLE" INDX="20" />
         <ELEMENT TAG="AxisCorrMon.A4" TYPE="DOUBLE" INDX="21" />
         <ELEMENT TAG="AxisCorrMon.A5" TYPE="DOUBLE" INDX="22" />
         <ELEMENT TAG="AxisCorrMon.A6" TYPE="DOUBLE" INDX="23" />
         <ELEMENT TAG="AxisCorrMon.E1" TYPE="DOUBLE" INDX="24" />
         <ELEMENT TAG="AxisCorrMon.E2" TYPE="DOUBLE" INDX="25" />
         <ELEMENT TAG="AxisCorrMon.E3" TYPE="DOUBLE" INDX="26" />
         <ELEMENT TAG="AxisCorrMon.E4" TYPE="DOUBLE" INDX="27" />
         <ELEMENT TAG="AxisCorrMon.E5" TYPE="DOUBLE" INDX="28" />
         <ELEMENT TAG="AxisCorrMon.E6" TYPE="DOUBLE" INDX="29" />
      </ELEMENTS>
   </SEND>

   <!-- =================== RECEIVE: PC to Robot ======================== -->
   <RECEIVE>
      <ELEMENTS>
         <ELEMENT TAG="DEF_EStr" TYPE="STRING" INDX="INTERNAL" />      <!-- Notification or error message -->

         <!-- Technology parameters in the advance run, function generators 1-6 -->
         <ELEMENT TAG="DEF_Tech.T1" TYPE="DOUBLE" INDX="INTERNAL" HOLDON="0" />
         <ELEMENT TAG="DEF_Tech.T2" TYPE="DOUBLE" INDX="INTERNAL" HOLDON="0" />
         <ELEMENT TAG="DEF_Tech.T3" TYPE="DOUBLE" INDX="INTERNAL" HOLDON="0" />
         <ELEMENT TAG="DEF_Tech.T4" TYPE="DOUBLE" INDX="INTERNAL" HOLDON="0" />
         <ELEMENT TAG="DEF_Tech.T5" TYPE="DOUBLE" INDX="INTERNAL" HOLDON="0" />
         <ELEMENT TAG="DEF_Tech.T6" TYPE="DOUBLE" INDX="INTERNAL" HOLDON="0" />

         <!-- Channels 1-6: Cartesian corrections (POSCORR1) -->
         <ELEMENT TAG="RKorr.X" TYPE="DOUBLE" INDX="1" HOLDON="1" />
         <ELEMENT TAG="RKorr.Y" TYPE="DOUBLE" INDX="2" HOLDON="1" />
         <ELEMENT TAG="RKorr.Z" TYPE="DOUBLE" INDX="3" HOLDON="1" />
         <ELEMENT TAG="RKorr.A" TYPE="DOUBLE" INDX="4" HOLDON="1" />
         <ELEMENT TAG="RKorr.B" TYPE="DOUBLE" INDX="5" HOLDON="1" />
         <ELEMENT TAG="RKorr.C" TYPE="DOUBLE" INDX="6" HOLDON="1" />

         <!-- Channels 7-12: joint corrections (AXISCORR1) -->
         <ELEMENT TAG="AKorr.A1" TYPE="DOUBLE" INDX="7" HOLDON="1" />
         <ELEMENT TAG="AKorr.A2" TYPE="DOUBLE" INDX="8" HOLDON="1" />
         <ELEMENT TAG="AKorr.A3" TYPE="DOUBLE" INDX="9" HOLDON="1" />
         <ELEMENT TAG="AKorr.A4" TYPE="DOUBLE" INDX="10" HOLDON="1" />
         <ELEMENT TAG="AKorr.A5" TYPE="DOUBLE" INDX="11" HOLDON="1" />
         <ELEMENT TAG="AKorr.A6" TYPE="DOUBLE" INDX="12" HOLDON="1" />

         <!-- Channels 13-18: external axis corrections (AXISCORREXT1) -->
         <ELEMENT TAG="EKorr.E1" TYPE="DOUBLE" INDX="13" HOLDON="1" />
         <ELEMENT TAG="EKorr.E2" TYPE="DOUBLE" INDX="14" HOLDON="1" />
         <ELEMENT TAG="EKorr.E3" TYPE="DOUBLE" INDX="15" HOLDON="1" />
         <ELEMENT TAG="EKorr.E4" TYPE="DOUBLE" INDX="16" HOLDON="1" />
         <ELEMENT TAG="EKorr.E5" TYPE="DOUBLE" INDX="17" HOLDON="1" />
         <ELEMENT TAG="EKorr.E6" TYPE="DOUBLE" INDX="18" HOLDON="1" />

         <!-- Channel 19: digital output word (MAP2DIGOUT1) -->
         <ELEMENT TAG="DiO" TYPE="LONG" INDX="19" HOLDON="1" />
      </ELEMENTS>
   </RECEIVE>
</ROOT>