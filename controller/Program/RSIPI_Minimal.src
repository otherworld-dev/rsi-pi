&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF RSIPI_Minimal( )
  ; =========================================================================
  ; RSIPI Minimal Test Program
  ; =========================================================================
  ; Bare-bones RSI check with NO dependency on the Technology package:
  ;   - no $TECHPAR_C[] / $TECHPAR[] technology parameters
  ;   - no digital I/O, no $SEN_PREA
  ;
  ; It only verifies that:
  ;   1. The RSI context (RSIPI_Full.rsi) loads        -> RSI_CREATE
  ;   2. RSI activates and the UDP link comes up       -> RSI_ON
  ;   3. Corrections streamed from Python are applied  -> RSI_MOVECORR
  ;
  ; Use this first if RSIPI_Test.src reports "variable not defined" on
  ; $TECHPAR lines (see docs/controller-setup.md section 4) or to prove
  ; the network link before running the full test.
  ;
  ; Python side: examples/first_contact.py (or any correction sender), and
  ; it must be RUNNING AND WAITING before RSI_ON: the ETHERNET object starts
  ; the 4 ms exchange immediately and breaks off with "RSIBad" after Timeout
  ; unanswered cycles (100 x 4 ms = 0.4 s). This program HALTs before RSI_ON
  ; so you can start the sender, then press Start to continue.
  ;
  ; To stop: cancel the program on the pendant, or stop the Python side
  ; and let the ETHERNET object time out (motion stops, RSI reports a
  ; communication error - this is expected and safe).
  ;
  ; See docs/controller-setup.md for installation and troubleshooting.
  ; =========================================================================

  DECL INT ret, CONTID

  ; A bare INI is not a KRL statement (it parses as a call and errors with
  ; '"(" expected') - the initialisation lives in this FOLD, exactly as in
  ; KUKA's own RSI_Ethernet.src example.
  ;FOLD INI
    ;FOLD BASISTECH INI
    BAS (#INITMOV,0 )
    ;ENDFOLD (BASISTECH INI)
    ;FOLD USER INI
      ;Make your modifications here
    ;ENDFOLD (USER INI)
  ;ENDFOLD (INI)

  ; -- Start from a known pose ----------------------------------------------
  ; The standard HOME inline form (all six axes to XHOME, 20 %), exactly as
  ; the pendant generates it, so every run starts from the same place - the
  ; teleop fence and the test scripts assume it. In T1 it is the BCO run.
  ; Delete the FOLD to start RSI from wherever the robot happens to be.
  ;FOLD PTP HOME Vel= 20 % DEFAULT;%{PE}%R 8.3.44,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:20, 7:DEFAULT
  $BWDSTART = FALSE
  PDAT_ACT=PDEFAULT
  FDAT_ACT=FHOME
  BAS (#PTP_PARAMS,20 )
  $H_POS=XHOME
  PTP  XHOME
  ;ENDFOLD

  ; -- Cell-specific start pose --------------------------------------------
  ; HOME puts the wrist at A5 = 0, which is the wrist singularity: Cartesian
  ; corrections there make A4/A6 swing and drove A5 into its software limit
  ; on 2026-09-10. For real work add a PTP to a taught pose with the wrist
  ; bent (A5 well away from 0) here, e.g.
  ;   PTP {A1 4.0, A2 -88.2, A3 87.6, A4 0.0, A5 90.6, A6 3.6}
  ; That pose belongs to one cell, so it is not shipped with the library.

  ; -- Load RSI signal flow configuration -----------------------------------
  ; RSIPI_Basic.rsi must be in Config\User\Common\SensorInterface.
  ; Basic = KUKA's proven RSI_Ethernet example plus AXISCORR (joint
  ; corrections). Use RSIPI_Full.rsi ONLY on cells that actually have
  ; external axes - its AXISCORREXT/external-axis channels make the
  ; ETHERNET object report RSIBad on a plain 6-axis robot.
  ret = RSI_CREATE("RSIPI_Basic.rsi", CONTID, TRUE)
  IF (ret <> RSIOK) THEN
    MsgNotify("RSI_CREATE failed - check SensorInterface files", "RSIPI_Minimal")
    HALT
  ENDIF

  ; -- Gate: the PC must be listening before the exchange starts -------------
  ; ETHERNET1 sends its first packet the moment RSI_ON runs and reports
  ; RSIBad (robot stops) after Timeout unanswered cycles - 0.4 s. Start the
  ; Python sender now; it waits for the robot's first packet. Then press
  ; Start on the pendant to continue past this HALT.
  MsgNotify("Start the Python sender, then press Start", "RSIPI_Minimal")
  HALT

  ; -- Activate RSI ----------------------------------------------------------
  ; RELATIVE corrections in the default #IPO_FAST sensor mode (4ms cycle),
  ; exactly like KUKA's own RSI_Ethernet example (KST RSI 3.3 manual, 8.1.3).
  ; Do not pass #IPO here: in IPO mode corrections only apply to LIN/CIRC
  ; path motions and function generator 1 must be free (manual 4.1, 7.1.4).
  ret = RSI_ON(#RELATIVE)
  IF (ret <> RSIOK) THEN
    MsgNotify("RSI_ON failed - check network config", "RSIPI_Minimal")
    HALT
  ENDIF

  MsgNotify("RSI active - corrections from Python are live", "RSIPI_Minimal")

  ; -- Sensor-guided motion --------------------------------------------------
  ; The robot holds position and applies RKorr corrections streamed from
  ; Python. Blocks until the program is cancelled or RSI stops.
  RSI_MOVECORR()

  ; -- Clean up ----------------------------------------------------------------
  ret = RSI_OFF()
  IF (ret <> RSIOK) THEN
    MsgNotify("RSI_OFF warning", "RSIPI_Minimal")
  ENDIF

  ret = RSI_DELETE(CONTID)

  MsgNotify("RSIPI_Minimal complete", "RSIPI_Minimal")

END
