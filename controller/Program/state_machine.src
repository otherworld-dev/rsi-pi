&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF state_machine()
; ================================================================
; Multi-State Coordination Pattern
; ================================================================
; Demonstrates a state machine for complex Python-KRL workflows.
; Uses both I/O signals and Tech variables for robust coordination.
;
; State Definitions:
;   State 0: IDLE - Waiting to start
;   State 1: CALIBRATING - Python performing calibration
;   State 2: READY - Calibration complete, ready for motion
;   State 3: EXECUTING - Robot executing motion task
;   State 4: COMPLETE - Task finished
;   State 9: ERROR - Error condition
;
; I/O Mapping:
;   $OUT[1]: State signal to Python (pulse indicates state change)
;   $IN[1]:  Python acknowledgement
;   $IN[2]:  Python error signal
;
; Tech Variable Mapping:
;   Tech.C[11]: Current state (KRL → Python)
;   Tech.T[11]: Python command (0=continue, 1=pause, 2=abort)
;   Tech.T[22-24]: Calibration offset (X, Y, Z)
;
; Python Code Example:
;   api = RSIAPI('RSI_EthernetConfig.xml')
;   api.start()
;
;   # Monitor state transitions (Tech.C - KRL writes, Python reads)
;   while True:
;       state = api.krl.read_param('C11')
;
;       if state == 1:  # CALIBRATING
;           print("Performing calibration...")
;           # Calibration logic here
;           offset_x = 5.0
;           offset_y = -2.0
;           offset_z = 0.5
;
;           # Write calibration results (Tech.T - Python writes, KRL reads)
;           api.krl.write_param('T22', offset_x)
;           api.krl.write_param('T23', offset_y)
;           api.krl.write_param('T24', offset_z)
;
;           # Acknowledge state completion (group=None auto-detects the
;           # DiO word - the default group='Digout' targets a SEND-only
;           # echo group and raises)
;           api.krl.signal_complete(1, group=None)
;
;       elif state == 3:  # EXECUTING
;           print("Robot executing motion...")
;           # Monitor execution, send corrections if needed
;           api.motion.update_cartesian(X=offset_x, Y=offset_y)
;
;       elif state == 4:  # COMPLETE
;           print("Task complete!")
;           break
;
;       elif state == 9:  # ERROR
;           print("Error detected, aborting!")
;           break
;
;       time.sleep(0.1)
;
;   api.stop()
; ================================================================

  ; Variable declarations
  INT current_state, python_cmd
  REAL offset_x, offset_y, offset_z
  E6POS target_pos, start_pos
  BOOL ack_received
  INT timeout_counter

  BAS(#INITMOV, 0)

  ; Remembered so the program can return here in plain KRL, without the
  ; pendant-generated HOME fold (see the motion notes below).
  start_pos = $POS_ACT

  ; Initialize state machine
  current_state = 0  ; IDLE
  $TECHPAR_C[1,1] = current_state

  ; ============================================================
  ; STATE 0: IDLE
  ; ============================================================
  current_state = 0
  $TECHPAR_C[1,1] = current_state
  WAIT SEC 1.0

  ; ============================================================
  ; STATE 1: CALIBRATING
  ; ============================================================
  current_state = 1
  $TECHPAR_C[1,1] = current_state

  ; Signal Python to start calibration
  $OUT[1] = TRUE
  WAIT SEC 0.1
  $OUT[1] = FALSE

  ; Wait for Python calibration completion
  ack_received = FALSE
  timeout_counter = 0

  WHILE (ack_received == FALSE) AND (timeout_counter < 200)
    ; Check for error signal
    IF $IN[2] == TRUE THEN
      current_state = 9  ; ERROR
      $TECHPAR_C[1,1] = current_state
      HALT
    ENDIF

    ; Check for completion
    IF $IN[1] == TRUE THEN
      ack_received = TRUE
    ELSE
      WAIT SEC 0.1
      timeout_counter = timeout_counter + 1
    ENDIF
  ENDWHILE

  IF ack_received == FALSE THEN
    ; Timeout error
    current_state = 9
    $TECHPAR_C[1,1] = current_state
    HALT
  ENDIF

  ; ============================================================
  ; STATE 2: READY
  ; ============================================================
  ; Read calibration offsets from Python (Tech.T - Python writes, KRL
  ; reads; T22-T24 avoid colliding with T11, the command slot below)
  offset_x = $TECHPAR[2,2]
  offset_y = $TECHPAR[2,3]
  offset_z = $TECHPAR[2,4]

  current_state = 2
  $TECHPAR_C[1,1] = current_state

  ; Signal ready
  $OUT[1] = TRUE
  WAIT SEC 0.1
  $OUT[1] = FALSE
  WAIT SEC 0.5

  ; ============================================================
  ; STATE 3: EXECUTING
  ; ============================================================
  current_state = 3
  $TECHPAR_C[1,1] = current_state

  ; Calculate target with calibration offset
  target_pos = $POS_ACT
  target_pos.X = target_pos.X + offset_x
  target_pos.Y = target_pos.Y + offset_y
  target_pos.Z = target_pos.Z + offset_z

  ; Execute motion (Python can send RSI corrections during this).
  ; Plain-KRL form: the inline
  ;   LIN target_pos Vel=0.3 m/s CPDAT1 Tool[1] Base[0]
  ; only compiles inside a pendant-generated FOLD that carries the CPDAT
  ; declarations, so set the Cartesian velocity explicitly instead.
  ; $TOOL/$BASE are whatever the calling program selected.
  $VEL.CP = 0.3   ; m/s
  LIN target_pos

  ; Check for pause/abort commands (Tech.T - Python writes, KRL reads;
  ; a separate slot from the state variable, which uses Tech.C[11])
  python_cmd = $TECHPAR[2,1]
  IF python_cmd == 2 THEN
    ; Abort requested
    current_state = 9
    $TECHPAR_C[1,1] = current_state
    HALT
  ENDIF

  ; ============================================================
  ; STATE 4: COMPLETE
  ; ============================================================
  current_state = 4
  $TECHPAR_C[1,1] = current_state

  ; Signal completion
  $OUT[1] = TRUE
  WAIT SEC 0.2
  $OUT[1] = FALSE

  ; Return to where the program started (plain KRL - "PTP HOME Vel=100 %
  ; DEFAULT" is inline form and needs a pendant FOLD plus XHOME in
  ; $CONFIG.DAT)
  BAS(#VEL_PTP, 100)
  PTP start_pos

  ; Final state update
  current_state = 0  ; Back to IDLE
  $TECHPAR_C[1,1] = current_state

END
