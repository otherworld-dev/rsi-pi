&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF parameter_passing()
; ================================================================
; Parameter Passing via Tech Variables
; ================================================================
; Demonstrates bidirectional numerical data exchange between KRL
; and Python using RSI Tech variables.
;
; Tech Variable Conventions:
;   - Tech.C[11-110]: KRL writes, Python reads (Control variables -
;     KRL-to-Python channel; see krl_api.py's read_param())
;   - Tech.T[21-210]: Python writes, KRL reads (Transfer variables -
;     Python-to-KRL channel; see krl_api.py's write_param(). T2 is the
;     generator declared under <RECEIVE> in the default config)
;
; Python-KRL Coordination Flow:
; 1. KRL writes current position to Tech.C
; 2. Python reads position from Tech.C
; 3. Python processes data and writes target to Tech.T
; 4. KRL reads target from Tech.T and executes motion
;
; Python Code Example:
;   api = RSIAPI('RSI_EthernetConfig.xml')
;   api.start()
;
;   # Wait for KRL to signal data ready (group=None auto-detects the
;   # DiL word - the default group='Digin' does not exist in either
;   # shipped config and raises immediately)
;   api.krl.wait_for_signal(1, group=None)
;
;   # Read current position from KRL (Tech.C - KRL writes it)
;   current_x = api.krl.read_param('C11')
;   current_y = api.krl.read_param('C12')
;   current_z = api.krl.read_param('C13')
;
;   # Calculate target (e.g., move 100mm in X)
;   target_x = current_x + 100.0
;   target_y = current_y
;   target_z = current_z
;
;   # Write target back to KRL (Tech.T - Python writes it)
;   api.krl.write_param('T21', target_x)
;   api.krl.write_param('T22', target_y)
;   api.krl.write_param('T23', target_z)
;
;   # Signal completion (group=None auto-detects the DiO word - the
;   # default group='Digout' targets a SEND-only echo group and raises)
;   api.krl.signal_complete(1, group=None)
;
;   api.stop()
; ================================================================

  ; Variable declarations
  E6POS current_pos, target_pos
  REAL target_x, target_y, target_z
  INT i
  BOOL data_ready

  BAS(#INITMOV, 0)

  ; ============================================================
  ; STEP 1: KRL writes current position to Tech.C
  ; ============================================================
  current_pos = $POS_ACT  ; Get current TCP position

  ; Write position components to Control variables (Python reads)
  $TECH.C[11] = current_pos.X
  $TECH.C[12] = current_pos.Y
  $TECH.C[13] = current_pos.Z
  $TECH.C[14] = current_pos.A
  $TECH.C[15] = current_pos.B
  $TECH.C[16] = current_pos.C

  ; ============================================================
  ; STEP 2: Signal Python that data is ready
  ; ============================================================
  $OUT[1] = TRUE
  WAIT SEC 0.1

  ; ============================================================
  ; STEP 3: Wait for Python to process and write target
  ; ============================================================
  data_ready = FALSE
  i = 0

  ; Poll input 1 for Python completion signal
  WHILE (data_ready == FALSE) AND (i < 100)
    IF $IN[1] == TRUE THEN
      data_ready = TRUE
    ELSE
      WAIT SEC 0.1
      i = i + 1
    ENDIF
  ENDWHILE

  IF data_ready == TRUE THEN
    ; ============================================================
    ; STEP 4: Read target position from Tech.T
    ; ============================================================
    ; Python has written to Transfer variables (KRL reads). T21-T23 are
    ; the slots the default config declares (via DEF_Tech.T2).
    target_x = $TECH.T[21]
    target_y = $TECH.T[22]
    target_z = $TECH.T[23]

    ; Construct target pose
    target_pos = current_pos  ; Copy orientation
    target_pos.X = target_x
    target_pos.Y = target_y
    target_pos.Z = target_z

    ; ============================================================
    ; STEP 5: Execute motion to target
    ; ============================================================
    ; Reset signals
    $OUT[1] = FALSE

    ; Move to calculated target
    LIN target_pos Vel=0.5 m/s CPDAT1 Tool[1] Base[0]

    ; Success indication
    WAIT SEC 0.5

  ELSE
    ; Timeout - halt for safety
    HALT
  ENDIF

END
