<ROOT>
   <CONFIG>
      <IP_NUMBER>10.10.10.10</IP_NUMBER>   <!-- IP-number of the external socket -->
      <PORT>64000</PORT>                   <!-- Port-number of the external socket -->      
      <SENTYPE>ImFree</SENTYPE>        <!-- The name of your system send in <Sen Type="" > -->     
      <ONLYSEND>FALSE</ONLYSEND>       <!-- TRUE means the client don't expect answers. Do not send anything to robot -->
   </CONFIG>
   <!-- RSI Data: TYPE=  "BOOL", "STRING", "LONG", "DOUBLE" -->
   <!-- INDX= "INTERNAL" switch on internal read values. Needed by DEF_... -->
   <!-- INDX= "nmb" Input/Output index of RSI-Object / Maximum of RSI Channels: 64  -->   
   <!-- HOLDON="1", set this output index of RSI Object to the last value  -->   
   <!-- DEF_Delay count the late packages and send it back to server  -->
   <!-- DEF_Tech: .T = advance .C = main run / .T1 advance set function generator 1 -->
   
   <SEND>
      <ELEMENTS>
         <ELEMENT TAG="DEF_RIst" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_RSol" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_AIPos" TYPE="DOUBLE" INDX="INTERNAL" />	<!-- Axis actual -->
         <ELEMENT TAG="DEF_ASPos" TYPE="DOUBLE" INDX="INTERNAL" />	<!-- Axis setpoint -->
         <ELEMENT TAG="DEF_Delay" TYPE="LONG" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_Tech.C1" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="DiL" TYPE="LONG" INDX="1" />
         <ELEMENT TAG="Digout.o1" TYPE="BOOL" INDX="2" />
         <ELEMENT TAG="Digout.o2" TYPE="BOOL" INDX="3" />
         <ELEMENT TAG="Digout.o3" TYPE="BOOL" INDX="4" />
         <ELEMENT TAG="Source1" TYPE="DOUBLE" INDX="5" />
         <ELEMENT TAG="DoutW" TYPE="LONG" INDX="6" />	<!-- read-back of the byte range MAP2DIGOUT1 writes -->
         <ELEMENT TAG="DEF_MACur" TYPE="DOUBLE" INDX="INTERNAL" />
         <ELEMENT TAG="PosCorrMon.X" TYPE="DOUBLE" INDX="7" />
         <ELEMENT TAG="PosCorrMon.Y" TYPE="DOUBLE" INDX="8" />
         <ELEMENT TAG="PosCorrMon.Z" TYPE="DOUBLE" INDX="9" />
         <ELEMENT TAG="PosCorrMon.A" TYPE="DOUBLE" INDX="10" />
         <ELEMENT TAG="PosCorrMon.B" TYPE="DOUBLE" INDX="11" />
         <ELEMENT TAG="PosCorrMon.C" TYPE="DOUBLE" INDX="12" />
         <ELEMENT TAG="AxisCorrMon.A1" TYPE="DOUBLE" INDX="13" />
         <ELEMENT TAG="AxisCorrMon.A2" TYPE="DOUBLE" INDX="14" />
         <ELEMENT TAG="AxisCorrMon.A3" TYPE="DOUBLE" INDX="15" />
         <ELEMENT TAG="AxisCorrMon.A4" TYPE="DOUBLE" INDX="16" />
         <ELEMENT TAG="AxisCorrMon.A5" TYPE="DOUBLE" INDX="17" />
         <ELEMENT TAG="AxisCorrMon.A6" TYPE="DOUBLE" INDX="18" />
         <ELEMENT TAG="AnIn1" TYPE="DOUBLE" INDX="19" />
         <ELEMENT TAG="SenPInt1" TYPE="LONG" INDX="20" />
         <ELEMENT TAG="OvPro" TYPE="LONG" INDX="21" />
      </ELEMENTS>
   </SEND>
   <RECEIVE>
      <ELEMENTS>
         <ELEMENT TAG="DEF_EStr" TYPE="STRING" INDX="INTERNAL" />
         <ELEMENT TAG="DEF_Tech.T2" TYPE="DOUBLE" INDX="INTERNAL" HOLDON="0" />
         <ELEMENT TAG="RKorr.X" TYPE="DOUBLE" INDX="1" HOLDON="1" />
         <ELEMENT TAG="RKorr.Y" TYPE="DOUBLE" INDX="2" HOLDON="1" />
         <ELEMENT TAG="RKorr.Z" TYPE="DOUBLE" INDX="3" HOLDON="1" />
         <ELEMENT TAG="RKorr.A" TYPE="DOUBLE" INDX="4" HOLDON="1" />
         <ELEMENT TAG="RKorr.B" TYPE="DOUBLE" INDX="5" HOLDON="1" />
         <ELEMENT TAG="RKorr.C" TYPE="DOUBLE" INDX="6" HOLDON="1" />
         <ELEMENT TAG="FREE" TYPE="LONG" INDX="7" HOLDON="1" />
         <ELEMENT TAG="DiO" TYPE="LONG" INDX="8" HOLDON="1" />
         <ELEMENT TAG="AKorr.A1" TYPE="DOUBLE" INDX="9" HOLDON="1" />
         <ELEMENT TAG="AKorr.A2" TYPE="DOUBLE" INDX="10" HOLDON="1" />
         <ELEMENT TAG="AKorr.A3" TYPE="DOUBLE" INDX="11" HOLDON="1" />
         <ELEMENT TAG="AKorr.A4" TYPE="DOUBLE" INDX="12" HOLDON="1" />
         <ELEMENT TAG="AKorr.A5" TYPE="DOUBLE" INDX="13" HOLDON="1" />
         <ELEMENT TAG="AKorr.A6" TYPE="DOUBLE" INDX="14" HOLDON="1" />
         <ELEMENT TAG="SenP1" TYPE="DOUBLE" INDX="15" HOLDON="1" />	<!-- -> $SEN_PREA[1] -->
         <ELEMENT TAG="SenP2" TYPE="DOUBLE" INDX="16" HOLDON="1" />	<!-- -> $SEN_PREA[2] -->
         <ELEMENT TAG="SenP3" TYPE="DOUBLE" INDX="17" HOLDON="1" />	<!-- -> $SEN_PREA[3] -->
         <ELEMENT TAG="AnOut1" TYPE="DOUBLE" INDX="18" HOLDON="0" />
         <ELEMENT TAG="SenPIntW" TYPE="LONG" INDX="19" HOLDON="0" />
         <ELEMENT TAG="OvProW" TYPE="LONG" INDX="20" HOLDON="0" />
      </ELEMENTS>
   </RECEIVE>
</ROOT>